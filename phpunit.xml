<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true": Werte aus der Shell oder .env dürfen Tests nie auf echte Dienste umleiten. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <!-- config/*.php liest noch die alten Namen (*_DRIVER), die neuen schaden nicht. -->
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="MAIL_DRIVER" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="BROADCAST_DRIVER" value="null" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <!-- Tests laufen nie gegen die Dev-/Prod-Datenbank, siehe Tests\TestCase::beforeRefreshingDatabase() -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DATABASE_URL" value="" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!-- Externe Dienste: keine echten Schlüssel in Tests -->
        <env name="GOOGLE_MAPS_GEOCODING_API_KEY" value="" force="true"/>
        <env name="PUSHER_APP_KEY" value="" force="true"/>
        <env name="PUSHER_APP_SECRET" value="" force="true"/>
        <env name="PUSHER_APP_ID" value="" force="true"/>
        <env name="HITOBITO_BASE_URL" value="http://hitobito.invalid" force="true"/>
        <env name="HITOBITO_CLIENT_UID" value="test" force="true"/>
        <env name="HITOBITO_CLIENT_SECRET" value="test" force="true"/>
        <!-- BasisdatenSeeder braucht ein Admin-Passwort -->
        <env name="ADMIN_PASSWORD" value="password" force="true"/>
        <env name="MAIL_FROM_ADDRESS" value="zopf@example.com" force="true"/>
        <env name="MAIL_ACTION_ADDRESS" value="aktionen@example.com" force="true"/>
    </php>
</phpunit>
