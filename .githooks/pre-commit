#!/bin/sh
#
# Formatiert die gestagten PHP-Dateien vor jedem Commit mit Laravel Pint (Regeln: pint.json).
#
# Aktiv über: git config core.hooksPath .githooks (setzt composer install automatisch)
# Überspringen: git commit --no-verify
#
set -e

staged() {
    git diff --cached --name-only -z --diff-filter=ACMR -- '*.php'
}

if [ -z "$(staged | tr -d '\0')" ]; then
    exit 0
fi

if ! command -v php >/dev/null 2>&1 || [ ! -f vendor/bin/pint ]; then
    echo "pre-commit: PHP oder vendor/bin/pint nicht gefunden, Formatierung übersprungen (die CI prüft den Stil)." >&2
    exit 0
fi

# Teilweise gestagte Dateien nicht anfassen: Beim erneuten Stagen kämen sonst auch
# die bewusst nicht gestagten Änderungen in den Commit.
partial=$(staged | xargs -0 git diff --name-only --)
if [ -n "$partial" ]; then
    echo "pre-commit: Diese Dateien sind nur teilweise gestaged:" >&2
    echo "$partial" | sed 's/^/  /' >&2
    echo "Bitte ganz stagen oder vorher ./vendor/bin/pint ausführen (überspringen: git commit --no-verify)." >&2
    exit 1
fi

# Zweimal: Pint braucht bei zusammengedrängtem Code (z. B. Einzeilern) manchmal zwei Durchläufe,
# sonst meldet die CI (pint --test) danach noch Abweichungen.
staged | xargs -0 php vendor/bin/pint --quiet
staged | xargs -0 php vendor/bin/pint --quiet
staged | xargs -0 git add --
