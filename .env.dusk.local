# Umgebung für Laravel Dusk (php artisan dusk im Sail-Container): Dusk ersetzt während des Laufs die .env durch diese Datei.
# Keine Geheimnisse, keine echten Dienste. Der Browser (Selenium-Container) ruft die App unter laravel.test auf.
# Gleiche Env-Namen wie config/*.php und phpunit.xml.
APP_NAME=Zopfaktion
APP_ENV=local
APP_KEY=base64:juYjkRaIJLIfngVQjgJhXy1SrJ4+QVr7q7OvDjJNzvA=
APP_DEBUG=true
APP_URL=http://laravel.test

# SQLite als Datei: Testprozess und Webserver müssen dieselbe Datenbank sehen (in-memory geht nicht)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/dusk.sqlite

CACHE_DRIVER=array
CACHE_STORE=array
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=zopf@example.com
MAIL_FROM_NAME=Zopfaktion
MAIL_ACTION_ADDRESS=aktionen@example.com
MAIL_ACTION_NAME=Zopfaktion
TELESCOPE_ENABLED=false
BCRYPT_ROUNDS=4
ADMIN_PASSWORD=password

# Externe Dienste: keine echten Schlüssel
VITE_PUSHER_APP_ID=
VITE_PUSHER_APP_KEY=
PUSHER_APP_SECRET=
VITE_PUSHER_APP_CLUSTER=eu
GOOGLE_MAPS_GEOCODING_API_KEY=
GEOCODER_FAKE=true
HITOBITO_BASE_URL=http://hitobito.invalid
HITOBITO_CLIENT_UID=test
HITOBITO_CLIENT_SECRET=test
GITHUB_TOKEN=
GITHUB_API_URL=http://github.invalid
GITHUB_USER=test

# Sicherheitsnetz: Jede ausgehende HTTPS-Anfrage des Servers (Guzzle, Http-Client) scheitert sofort,
# z. B. Geocoding bei Google. Den Browser schützt DuskTestCase (--host-resolver-rules).
HTTPS_PROXY=http://127.0.0.1:9
https_proxy=http://127.0.0.1:9

# Sail: Selenium statt lokalem ChromeDriver
DUSK_DRIVER_URL=http://selenium:4444/wd/hub
